name: Update last updated date
on:
  push:
    branches: [ main ]

jobs:
  set-date:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Set formatted date
        id: date
        run: |
          echo "DATE=$(date -u '+%B %e, %Y')" >> $GITHUB_OUTPUT
      - name: Update files with placeholder
        run: |
          FILES="terms.html privacy.html"
          for f in $FILES; do
            if [ -f "$f" ]; then
              # replace placeholder <!-- LAST_UPDATED --> with the date string
              sed -i "s/<!-- LAST_UPDATED -->/Last updated: ${DATE} - Tran Quang Hiep/" "$f"
            fi
          done
      - name: Commit changes
        run: |
          if [ -n "$(git status --porcelain)" ]; then
            git config user.name "github-actions[bot]"
            git config user.email "github-actions[bot]@users.noreply.github.com"
            git add terms.html privacy.html
            git commit -m "chore: update Last updated date"
            git push
          else
            echo "No changes to commit"
          fi
