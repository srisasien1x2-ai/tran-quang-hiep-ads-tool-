name: Update last updated date
on:
  push:
    branches: [ main ]

permissions:
  contents: write    # cần để action push commit trở lại repo

jobs:
  set-date:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set formatted date (UTC)
        run: |
          echo "DATE=$(date -u '+%B %e, %Y')" >> $GITHUB_ENV

      - name: Update files with placeholder
        run: |
          FILES="terms.html privacy.html"
          for f in $FILES; do
            if [ -f "$f" ]; then
              sed -i "s/<!-- LAST_UPDATED -->/Last updated: $DATE - Tran Quang Hiep/" "$f"
            fi
          done

      - name: Commit changes
        run: |
          if [ -n "$(git status --porcelain)" ]; then
            git config user.name "github-actions[bot]"
            git config user.email "github-actions[bot]@users.noreply.github.com"
            git add terms.html privacy.html
            git commit -m "chore: update Last updated date"
            git push
          else
            echo "No changes to commit"
          fi
